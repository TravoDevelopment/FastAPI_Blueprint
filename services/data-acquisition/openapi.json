{
  "components": {
    "schemas": {
      "ClaimScheduleOccurrenceRequest": {
        "description": "Schedule identifier required to claim an existing occurrence.",
        "properties": {
          "scheduleId": {
            "format": "uuid",
            "title": "Scheduleid",
            "type": "string"
          }
        },
        "required": [
          "scheduleId"
        ],
        "title": "ClaimScheduleOccurrenceRequest",
        "type": "object"
      },
      "CreateScrapingScheduleRequest": {
        "description": "Request body for creating a disabled weekly schedule.",
        "properties": {
          "frequency": {
            "$ref": "#/components/schemas/ScheduleFrequency",
            "default": "weekly"
          },
          "intervalDays": {
            "default": 7,
            "minimum": 1.0,
            "title": "Intervaldays",
            "type": "integer"
          },
          "name": {
            "maxLength": 120,
            "minLength": 3,
            "title": "Name",
            "type": "string"
          },
          "nextRunAt": {
            "format": "date-time",
            "title": "Nextrunat",
            "type": "string"
          }
        },
        "required": [
          "name",
          "nextRunAt"
        ],
        "title": "CreateScrapingScheduleRequest",
        "type": "object"
      },
      "CreatedScrapingJobsResponse": {
        "description": "Child jobs created from a discovery snapshot.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ScrapingJobResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "totalCount": {
            "title": "Totalcount",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "totalCount"
        ],
        "title": "CreatedScrapingJobsResponse",
        "type": "object"
      },
      "DiscoverScrapingJobsRequest": {
        "description": "Snapshot of sources to turn into child scraping jobs.",
        "properties": {
          "discoverySnapshot": {
            "items": {
              "$ref": "#/components/schemas/DiscoverySource"
            },
            "title": "Discoverysnapshot",
            "type": "array"
          }
        },
        "required": [
          "discoverySnapshot"
        ],
        "title": "DiscoverScrapingJobsRequest",
        "type": "object"
      },
      "DiscoverySource": {
        "description": "One source and category discovered for a parent execution.",
        "properties": {
          "categoryId": {
            "format": "uuid",
            "title": "Categoryid",
            "type": "string"
          },
          "sourceId": {
            "format": "uuid",
            "title": "Sourceid",
            "type": "string"
          },
          "sourceUrl": {
            "minLength": 1,
            "title": "Sourceurl",
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "sourceUrl",
          "categoryId"
        ],
        "title": "DiscoverySource",
        "type": "object"
      },
      "FailScrapingJobRequest": {
        "description": "Failure details recorded for a scraping or review attempt.",
        "properties": {
          "errorCode": {
            "minLength": 1,
            "title": "Errorcode",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "errorCode",
          "retryable"
        ],
        "title": "FailScrapingJobRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PageInfo": {
        "properties": {
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "pageSize": {
            "title": "Pagesize",
            "type": "integer"
          },
          "totalCount": {
            "title": "Totalcount",
            "type": "integer"
          }
        },
        "required": [
          "page",
          "pageSize",
          "totalCount"
        ],
        "title": "PageInfo",
        "type": "object"
      },
      "ParentExecutionResponse": {
        "description": "Parent execution status and aggregate child-job summary.",
        "properties": {
          "cancelledCount": {
            "title": "Cancelledcount",
            "type": "integer"
          },
          "completedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completedat"
          },
          "createdAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Createdat"
          },
          "discoveryCompleted": {
            "title": "Discoverycompleted",
            "type": "boolean"
          },
          "failedCount": {
            "title": "Failedcount",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "occurrenceId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurrenceid"
          },
          "scheduleId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduleid"
          },
          "startedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Startedat"
          },
          "status": {
            "$ref": "#/components/schemas/ParentExecutionStatus"
          },
          "succeededCount": {
            "title": "Succeededcount",
            "type": "integer"
          },
          "totalCount": {
            "title": "Totalcount",
            "type": "integer"
          },
          "triggerType": {
            "$ref": "#/components/schemas/TriggerType"
          }
        },
        "required": [
          "id",
          "triggerType",
          "status",
          "scheduleId",
          "occurrenceId",
          "discoveryCompleted",
          "createdAt",
          "startedAt",
          "completedAt",
          "totalCount",
          "succeededCount",
          "failedCount",
          "cancelledCount"
        ],
        "title": "ParentExecutionResponse",
        "type": "object"
      },
      "ParentExecutionStatus": {
        "enum": [
          "discovering",
          "running",
          "succeeded",
          "partial_failed",
          "failed",
          "cancelled"
        ],
        "title": "ParentExecutionStatus",
        "type": "string"
      },
      "RecordScrapingResultRequest": {
        "description": "Reference to the result produced by a scraper.",
        "properties": {
          "resultReference": {
            "minLength": 1,
            "title": "Resultreference",
            "type": "string"
          }
        },
        "required": [
          "resultReference"
        ],
        "title": "RecordScrapingResultRequest",
        "type": "object"
      },
      "RetryPolicyResponse": {
        "description": "Retry settings exposed with a scraping job.",
        "properties": {
          "delaySeconds": {
            "title": "Delayseconds",
            "type": "integer"
          },
          "maxAttempts": {
            "title": "Maxattempts",
            "type": "integer"
          }
        },
        "required": [
          "maxAttempts",
          "delaySeconds"
        ],
        "title": "RetryPolicyResponse",
        "type": "object"
      },
      "ScheduleFrequency": {
        "enum": [
          "weekly"
        ],
        "title": "ScheduleFrequency",
        "type": "string"
      },
      "ScrapingJobList": {
        "description": "One page of child jobs and its pagination metadata.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ScrapingJobResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "items",
          "pageInfo"
        ],
        "title": "ScrapingJobList",
        "type": "object"
      },
      "ScrapingJobResponse": {
        "description": "One child scraping job as returned by the API.",
        "properties": {
          "categoryId": {
            "format": "uuid",
            "title": "Categoryid",
            "type": "string"
          },
          "createdAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Createdat"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "parentExecutionId": {
            "format": "uuid",
            "title": "Parentexecutionid",
            "type": "string"
          },
          "resultReference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resultreference"
          },
          "retryPolicy": {
            "$ref": "#/components/schemas/RetryPolicyResponse"
          },
          "sourceId": {
            "format": "uuid",
            "title": "Sourceid",
            "type": "string"
          },
          "sourceUrl": {
            "title": "Sourceurl",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ScrapingJobStatus"
          },
          "updatedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updatedat"
          }
        },
        "required": [
          "id",
          "parentExecutionId",
          "sourceId",
          "sourceUrl",
          "categoryId",
          "status",
          "resultReference",
          "retryPolicy",
          "createdAt",
          "updatedAt"
        ],
        "title": "ScrapingJobResponse",
        "type": "object"
      },
      "ScrapingJobStatus": {
        "enum": [
          "queued",
          "scraping",
          "awaiting_review",
          "handing_off",
          "succeeded",
          "retryable_failure",
          "permanent_failure",
          "cancelled",
          "failed"
        ],
        "title": "ScrapingJobStatus",
        "type": "string"
      },
      "ScrapingScheduleResponse": {
        "description": "One schedule, including its enabled and soft-deleted state.",
        "properties": {
          "createdAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Createdat"
          },
          "frequency": {
            "$ref": "#/components/schemas/ScheduleFrequency"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "intervalDays": {
            "title": "Intervaldays",
            "type": "integer"
          },
          "isDeleted": {
            "title": "Isdeleted",
            "type": "boolean"
          },
          "isEnabled": {
            "title": "Isenabled",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "nextRunAt": {
            "format": "date-time",
            "title": "Nextrunat",
            "type": "string"
          },
          "updatedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updatedat"
          }
        },
        "required": [
          "id",
          "name",
          "frequency",
          "intervalDays",
          "nextRunAt",
          "isEnabled",
          "isDeleted",
          "createdAt",
          "updatedAt"
        ],
        "title": "ScrapingScheduleResponse",
        "type": "object"
      },
      "StartParentExecutionRequest": {
        "description": "Request body for starting a manual or scheduled parent execution.",
        "properties": {
          "occurrenceId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurrenceid"
          },
          "scheduleId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduleid"
          },
          "triggerType": {
            "$ref": "#/components/schemas/TriggerType"
          }
        },
        "required": [
          "triggerType"
        ],
        "title": "StartParentExecutionRequest",
        "type": "object"
      },
      "TriggerType": {
        "enum": [
          "scheduled",
          "manual"
        ],
        "title": "TriggerType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Access token issued by the identity service.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The Data Acquisition domain service.",
    "title": "Data Acquisition API",
    "version": "0.0.0-dev"
  },
  "openapi": "3.1.0",
