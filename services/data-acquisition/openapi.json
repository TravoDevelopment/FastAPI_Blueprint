          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartParentExecutionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParentExecutionResponse"
                }
              }
