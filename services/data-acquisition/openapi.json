            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Start a manual or scheduled parent execution",
        "tags": [
          "scraping-jobs"
        ]
      }
    },
    "/v1/parent-executions/{parent_execution_id}/scraping-jobs": {
      "get": {
        "operationId": "listScrapingJobsByParentExecution",
        "parameters": [
          {
            "description": "Parent execution identifier",
            "in": "path",
            "name": "parent_execution_id",
            "required": true,
            "schema": {
              "description": "Parent execution identifier",
              "format": "uuid",
              "title": "Parent Execution Id",
              "type": "string"
            }
          },
          {
            "description": "1-based page number",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "1-based page number",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Items per page (max 100)",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 20,
              "description": "Items per page (max 100)",
              "maximum": 100,
              "minimum": 1,
              "title": "Pagesize",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScrapingJobList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List child jobs for a parent execution",
        "tags": [
          "scraping-jobs"
        ]
      },
      "post": {
        "operationId": "discoverAndCreateScrapingJobs",
        "parameters": [
          {
            "description": "Parent execution identifier",
            "in": "path",
            "name": "parent_execution_id",
            "required": true,
            "schema": {
              "description": "Parent execution identifier",
              "format": "uuid",
              "title": "Parent Execution Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoverScrapingJobsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedScrapingJobsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create child jobs from a discovery snapshot",
        "tags": [
          "scraping-jobs"
        ]
      }
    },
